#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>

/ {
        keymap {
                compatible = "zmk,keymap";

                default_layer {
// -----------------------------------------------------------------------------------------
// |  TAB |  Q  |  W  |  E  |  R  |  T  |   |  Y  |  U   |  I   |   O  |  P  | BSPC |
// |  ESC |  A  |  S  |  D  |  F  |  G  |   |  H  |  J   |  K   |  L   |  VOL UP  |  VOL DOWN   |
// | SHFT |  Z  |  X  |  C  |  V  |  B  |   |  N  |  M   | LEFT | DOWN |  UP  | RIGHT  |
//                    | ALT | CTRL | GUI |   | SPC | BSPC  | RET  |
                        bindings = <
   &kp TAB   &kp Q &kp W &kp E &kp R &kp T   &kp Y &kp U  &kp I     &kp O    &kp P          &kp BSPC
   &kp ESC   &kp A &kp S &kp D &kp F &kp G   &kp H &kp J  &kp K     &kp L    &kp C_VOL_DN &kp C_VOL_UP
   &kp LSHFT &kp Z &kp X &kp C &kp V &kp B   &kp N &kp M  &kp LEFT  &kp DOWN &kp UP         &kp RIGHT
                  &kp LALT &kp LCTRL &kp LGUI   &kp SPC &kp BSPC &kp RET
                        >;
                };
                lower_layer {
// -----------------------------------------------------------------------------------------
// |  TAB |  1  |  2  |  3  |  4  |  5  |   |  6  |  7  |  8  |  9  |  0  | BSPC |
// | BTCLR| BT1 | BT2 | BT3 | BT4 | BT5 |   | LFT | DWN |  UP | RGT |     |      |
// | SHFT |     |     |    3 |     |     |   |     |     |     |     |     |      |
//                    | GUI |     | SPC |   | ENT |     | ALT |
                        bindings = <
   &trans &trans &trans &trans &trans &trans   &trans &kp N1 &kp N2 &kp N3 &trans &trans
   &trans &trans &trans &trans &trans &trans   &trans &kp N4 &kp N5 &kp N6 &trans &trans
   &trans &trans &trans &trans &trans &trans   &trans &kp N7 &kp N8 &kp N9 &trans &trans
                        &trans &trans &trans   &trans &kp N0 &trans
                        >;
                };

                raise_layer {
// -----------------------------------------------------------------------------------------
// |  TAB |  !  |  @  |  #  |  $  |  %  |   |  ^  |  &  |  *  |  (  |  )  | BSPC |
// | CTRL |     |     |     |     |     |   |  -  |  =  |  [  |  ]  |  \  |  `   |
// | SHFT |     |     |     |     |     |   |  _  |  +  |  {  |  }  | "|" |  ~   |
//                    | GUI |     | SPC |   | ENT |     | ALT |
                        bindings = <
   &trans &trans &trans &trans &trans &trans   &trans &kp F1 &kp F2  &kp F3  &kp F4  &trans
   &trans &trans &trans &trans &trans &trans   &trans &kp F5 &kp F6  &kp F7  &kp F8  &trans
   &trans &trans &trans &trans &trans &trans   &trans &kp F9 &kp F10 &kp F11 &kp F12 &trans
                        &trans &trans &trans   &trans &trans &trans
                        >;
                };
        };

  combos {
    compatible = "zmk,combos";

    /* number layer */
    d_f_num {
      timeout-ms = <30>;
      key-positions = <15 16>;
      bindings = <&tog 1>;
    };

    w_d_num {
      timeout-ms = <30>;
      key-positions = <2 15>;
      bindings = <&tog 1>;
    };

    /* function layer */
    q_w_fun {
      timeout-ms = <30>;
      key-positions = <1 2>;
      bindings = <&tog 2>;
    };

    /* common symbols */
    l_apo_dot {
      key-positions = <21 22>;
      bindings = <&kp DOT>;
    };

    k_l_comm {
      key-positions = <20 21>;
      bindings = <&kp COMMA>;
    };

    j_l_apo_coln {
      key-positions = <19 21 22>;
      bindings = <&kp COLON>;
    };

    j_k_l_scln {
      key-positions = <19 20 21>;
      bindings = <&kp SEMICOLON>;
    };

    i_l_quot {
      key-positions = <8 21>;
      bindings = <&kp SINGLE_QUOTE>;
    };

    u_l_dquo {
      key-positions = <7 21>;
      bindings = <&kp SINGLE_QUOTE>;
    };

    /* basic math symbols */
    y_u_eql {
      key-positions = <6 7>;
      bindings = <&kp EQUAL>;
    };

    h_j_mins {
      key-positions = <18 19>;
      bindings = <&kp MINUS>;
    };

    h_j_k_plus {
      key-positions = <18 19 20>;
      bindings = <&kp PLUS>;
    };

    n_m_unds {
      key-positions = <18 19 20>;
      bindings = <&kp UNDERSCORE>;
    };

    // number layer
    y_1_eql {
      key-positions = <6 7>;
      bindings = <&kp EQUAL>;
    };

    h_4_mins {
      key-positions = <18 19>;
      bindings = <&kp MINUS>;
    };

    h_4_5_plus {
      key-positions = <18 19 20>;
      bindings = <&kp PLUS>;
    };

    n_7_unds {
      key-positions = <18 19 20>;
      bindings = <&kp UNDERSCORE>;
    };

    /* parentheses */
    spc_u_lbrc {
      key-positions = <7 39>;
      bindings = <&kp LEFT_BRACKET>;
    };

    spc_i_rbrc {
      key-positions = <8 39>;
      bindings = <&kp RIGHT_BRACKET>;
    };

    spc_j_lprn {
      key-positions = <19 39>;
      bindings = <&kp LEFT_PARENTHESIS>;
    };

    spc_k_rprn {
      key-positions = <20 39>;
      bindings = <&kp RIGHT_PARENTHESIS>;
    };

    spc_m_lcbr {
      key-positions = <31 39>;
      bindings = <&kp LEFT_BRACE>;
    };

    spc_left_rcbr {
      key-positions = <32 39>;
      bindings = <&kp RIGHT_BRACE>;
    };

    // number layer
    spc_1_lbrc {
      key-positions = <7 39>;
      bindings = <&kp LEFT_BRACKET>;
    };

    spc_2_rbrc {
      key-positions = <8 39>;
      bindings = <&kp RIGHT_BRACKET>;
    };

    spc_4_lprn {
      key-positions = <19 39>;
      bindings = <&kp LEFT_PARENTHESIS>;
    };

    spc_5_rprn {
      key-positions = <20 39>;
      bindings = <&kp RIGHT_PARENTHESIS>;
    };

    spc_7_lcbr {
      key-positions = <31 39>;
      bindings = <&kp LEFT_BRACE>;
    };

    spc_8_rcbr {
      key-positions = <32 39>;
      bindings = <&kp RIGHT_BRACE>;
    };

    /* symbols */
    m_k_o_slsh {
      key-positions = <9 20 31>;
      bindings = <&kp SLASH>;
    };

    u_k_down_bsls {
      key-positions = <7 20 33>;
      bindings = <&kp SLASH>;
    };

    i_j_bspc_pipe {
      key-positions = <8 19 40>;
      bindings = <&kp SLASH>;
    };

    i_j_l_circ {
      key-positions = <8 19 40>;
      bindings = <&kp CARET>;
    };

    i_j_ret_lt {
      key-positions = <8 19 41>;
      bindings = <&kp LESS_THAN>;
    };

    u_k_spc_gt {
      key-positions = <7 20 39>;
      bindings = <&kp LESS_THAN>;
    };

    y_j_grv {
      key-positions = <6 19>;
      bindings = <&kp GRAVE>;
    };

    j_p_tild {
      key-positions = <10 19>;
      bindings = <&kp TILDE>;
    };

    y_u_i_hash {
      key-positions = <6 7 8>;
      bindings = <&kp HASH>;
    };

    u_down_perc {
      key-positions = <7 33>;
      bindings = <&kp PERCENT>;
    };

    u_i_l_exml {
      key-positions = <7 8 21>;
      bindings = <&kp EXCLAMATION>;
    };

    j_k_o_ques {
      key-positions = <9 19 20>;
      bindings = <&kp QUESTION>;
    };

    m_left_o_dlr {
      key-positions = <9 31 32>;
      bindings = <&kp DOLLAR>;
    };

    u_k_l_at {
      key-positions = <7 20 21>;
      bindings = <&kp AT_SIGN>;
    };

    h_k_ampr {
      key-positions = <18 20>;
      bindings = <&kp AMPERSAND>;
    };

    n_m_left_astr {
      key-positions = <30 31 32>;
      bindings = <&kp ASTERISK>;
    };

    /* navigation keys */
    u_i_o_home {
      key-positions = <7 8 9>;
      bindings = <&kp HOME>;
    };

    i_o_p_end {
      key-positions = <8 9 10>;
      bindings = <&kp HOME>;
    };

    n_down_pgdn {
      key-positions = <30 33>;
      bindings = <&kp PAGE_DOWN>;
    };

    n_down_pgup {
      key-positions = <30 34>;
      bindings = <&kp PAGE_UP>;
    };

    /* misc */
    q_s_c_f_t_reset {
      key-positions = <1 5 14 16 27>;
      bindings = <&sys_reset>;
    };

    y_j_left_l_p_reset {
      key-positions = <6 10 19 21 32>;
      bindings = <&sys_reset>;
    };
  };
};
